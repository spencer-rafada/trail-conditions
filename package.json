{
  "name": "trail-conditions",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p scripts && pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @trail-conditions/web build",
    "discover-trails": "tsx scripts/discover-trails.ts",
    "enrich-trails": "tsx scripts/enrich-trails.ts",
    "trail-names": "tsx scripts/trail-names.ts",
    "backtest": "tsx scripts/backtest.ts",
    "prod:db-setup": "tsx scripts/prod-db-setup.ts",
    "prod:secrets": "tsx scripts/prod-secrets.ts",
    "prod:deploy": "tsx scripts/prod-deploy.ts",
    "prod:fill-scores": "tsx scripts/prod-fill-scores.ts",
    "prod:calibration": "tsx scripts/prod-calibration.ts"
  },
  "devDependencies": {
    "@trail-conditions/model": "workspace:*",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
